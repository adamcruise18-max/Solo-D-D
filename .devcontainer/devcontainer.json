{
  // GitHub Codespaces setup for Last Light: Portland.
  // It runs FreeLLMAPI (free AI models, port 3001) and OpenCode (coding agent)
  // in the cloud, so nothing installs on your own computer. See CODESPACES.md.
  "name": "Last Light: Portland + OpenCode + FreeLLMAPI",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:1-22-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {}
  },
  "forwardPorts": [3001, 8080],
  "portsAttributes": {
    "3001": { "label": "FreeLLMAPI dashboard", "onAutoForward": "notify" },
    "8080": { "label": "Game (npm run serve)", "onAutoForward": "openBrowser" }
  },
  "postCreateCommand": "npm ci && npm install -g opencode-ai",
  "postStartCommand": "bash .devcontainer/start-freellmapi.sh",
  "customizations": {
    "codespaces": {
      "openFiles": ["CODESPACES.md"]
    }
  }
}
